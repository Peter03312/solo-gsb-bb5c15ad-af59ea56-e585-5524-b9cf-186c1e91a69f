# SQLite database file location (inside container /data is a mounted volume)
DB_PATH=/data/subtitles.db
# Secret used to sign session JWTs — override in production
JWT_SECRET=change-me-to-a-long-random-string
# HTTP port the API + built frontend are served on
PORT=8080
# Seed the built-in local accounts on first run (always created if missing)
SEED_USERS=true
# Load a small demo SRT when the database is brand new
SEED_SAMPLE_SRT=true
